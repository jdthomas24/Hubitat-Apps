}

@Field static final String HEADER_MAGIC_HEX = "f0debc0a"
@Field static final List<Integer> XML_KEY = [0x1F, 0x2D, 0x3C, 0x4B, 0x5A, 0x69, 0x78, 0xFF]
@Field static final byte[] AES_IV_BYTES = "0123456789abcdef".getBytes("UTF-8")
@Field static final int HOST_CH_ID = 250

@Field static final String LOGIN_XML =
    '<?xml version="1.0" encoding="UTF-8" ?><body><LoginUser version="1.1"><userName>%s</userName>' +
    '<password>%s</password><userVer>1</userVer></LoginUser><LoginNet version="1.1"><type>LAN</type>' +
    '<udpPort>0</udpPort></LoginNet></body>'

@Field static final String LOGOUT_XML =
    '<?xml version="1.0" encoding="UTF-8" ?><body><LoginUser version="1.1"><userName>%s</userName>' +
    '<password>%s</password><userVer>1</userVer></LoginUser></body>'

@Field static final String WEBHOOK_PUSH_XML =
    '<?xml version="1.0" encoding="UTF-8" ?><body><HaCfg version="1.1"><enable>%s</enable>' +
    '<url>%s</url><verify_cert>0</verify_cert></HaCfg></body>'

def installed() {}
def updated() {}

// ============================================================================
// Entry point
// ============================================================================
def testWebhookFlow() {
    log.info "===== TEST WEBHOOK FLOW: START ====="
    state.testMode = "webhook"
    state.messIdCounter = 0
    state.rxBufferHex = ""
    state.aesKeyHex = null
    state.nonce = null
    state.stage = "CONNECTING"
    try {
        interfaces.rawSocket.connect(host, port as int, byteInterface: true)
        log.info "Socket connect requested to ${host}:${port}"
    } catch (e) {
        log.warn "===== TEST WEBHOOK FLOW: FAILED to open socket -- ${e.message} ====="
        state.stage = null
        return
    }
    // give the connect a moment, then kick off the nonce request; if the
    // socket genuinely isn't open yet this send will throw and we'll know
    runIn(1, "sendNonceRequest")
    runIn(15, "flowTimeoutCheck")
}

/**
 * The RIGHT mechanism for a battery channel behind a Home Hub/NVR, unlike
 * testWebhookFlow() above. Confirmed from reolink_aio's own source:
 * is_battery = NOT is_nvr AND battery-on-channel-0 -- a Hub is always
 * is_nvr=True, so it's NEVER is_battery, so the webhook subscription branch
 * (testWebhookFlow's path) never even runs for a Hub in the reference
 * implementation. The actual mechanism used for a Hub/NVR is cmd_id=31, a
 * PERSISTENT TCP subscription (not a one-shot registration) kept alive with
 * periodic cmd_id=93 heartbeats -- real events (motion/AI/visitor/sleep)
 * then arrive as ongoing pushes over the SAME connection, indefinitely,
 * until stopped or the connection drops.
 */
def startEventSubscription() {
    log.info "===== EVENT SUBSCRIPTION: START (watching channel ${channel ?: 4}) ====="
    state.testMode = "subscribe"
    state.messIdCounter = 0
    state.rxBufferHex = ""
    state.aesKeyHex = null
    state.nonce = null
    state.stage = "CONNECTING"
    state.last33Status = null
    state.last33AiType = null
    state.last145State = null
    try {
        interfaces.rawSocket.connect(host, port as int, byteInterface: true)
        log.info "Socket connect requested to ${host}:${port}"
    } catch (e) {
        log.warn "===== EVENT SUBSCRIPTION: FAILED to open socket -- ${e.message} ====="
        state.stage = null
        return
    }
    runIn(1, "sendNonceRequest")
    runIn(15, "flowTimeoutCheck")
}

def stopEventSubscription() {
    log.info "===== EVENT SUBSCRIPTION: stopping ====="
    unschedule("sendKeepalive")
    unschedule("flowTimeoutCheck")
    if (state.stage == "SUBSCRIBED") {
        try {
            def messId = nextMessId()
            byte[] header = buildHeader1464(2, 0, HOST_CH_ID, messId, 0)
            sendRaw(header)
        } catch (e) { /* best effort logout, fine either way */ }
    }
    runIn(1, "closeSocket")
    state.stage = "DONE"
}

def socketStatus(String status) {
    log.info "Socket status: ${status}"
    if (status?.contains("error") || status?.contains("close")) {
        if (state.stage == "SUBSCRIBED") {
            log.warn "===== EVENT SUBSCRIPTION: connection lost -- run startEventSubscription again to resume ====="
            unschedule("sendKeepalive")
        } else if (state.stage && state.stage != "DONE") {
            log.warn "===== TEST FLOW: socket closed/errored mid-flow (stage was ${state.stage}) ====="
        }
        state.stage = null
    }
}

def flowTimeoutCheck() {
    // Does NOT apply once SUBSCRIBED -- staying connected indefinitely with
    // no response pending is the intended, correct state at that point.
    if (state.stage && state.stage != "DONE" && state.stage != "SUBSCRIBED") {
        log.warn "===== TEST FLOW: TIMED OUT waiting for a response (stuck at stage ${state.stage}) ====="
        try { interfaces.rawSocket.close() } catch (e) { }
        state.stage = null
    }
}

// ============================================================================
// Step 1: nonce request (cmd_id=1, no body, special 20-byte "1465" header)
// ============================================================================
def sendNonceRequest() {
    state.stage = "AWAITING_NONCE"
    def messId = nextMessId()
    byte[] header = buildHeader1465(1, HOST_CH_ID, messId)
    log.info "Step 1/5: sending nonce request (cmd_id=1)"
    sendRaw(header)
}

// ============================================================================
// Step 2: login (cmd_id=1, Baichuan-XOR body)
// ============================================================================
def sendLoginRequest() {
    state.stage = "AWAITING_LOGIN"
    def userHash = md5Modern("${username}${state.nonce}")
    def passHash = md5Modern("${password}${state.nonce}")
    String xml = String.format(LOGIN_XML, userHash, passHash)
    byte[] bodyBytes = xml.getBytes("UTF-8")
    byte[] encBody = xorBaichuan(bodyBytes, HOST_CH_ID)
    def messId = nextMessId()
    byte[] header = buildHeader1464(1, bodyBytes.length, HOST_CH_ID, messId, 0)
    log.info "Step 2/5: sending login request (cmd_id=1, Baichuan-encrypted)"
    sendRaw(concatBytes(header, encBody))
}

// ============================================================================
// Step 3: ability check (cmd_id=199, no body, AES)
// ============================================================================
def sendAbilityCheck() {
    state.stage = "AWAITING_ABILITY"
    def messId = nextMessId()
    byte[] header = buildHeader1464(199, 0, HOST_CH_ID, messId, 0)
    log.info "Step 3/5: sending ability check (cmd_id=199)"
    sendRaw(header)
}

// ============================================================================
// Event subscription path (persistent, for a Hub/NVR-relayed channel):
// cmd_id=31, ch_id=251 (the special "push" channel id, NOT 250/host) -- this
// is the mechanism that actually applies here, confirmed from reolink_aio's
// own is_battery gating (see startEventSubscription() doc comment above).
// ============================================================================
def sendSubscribe() {
    state.stage = "AWAITING_SUBSCRIBE"
    def messId = nextMessId()
    byte[] header = buildHeader1464(31, 0, 251, messId, 0)
    log.info "Sending event subscribe (cmd_id=31, ch_id=251 push channel)"
    sendRaw(header)
}

/**
 * Keepalive heartbeat (cmd_id=93, "LinkType"), sent roughly every 25s to keep
 * the subscription alive -- reolink_aio uses a 30s interval (KEEP_ALLIVE_INTERVAL),
 * 25s gives a safety margin. Reschedules itself as long as still SUBSCRIBED;
 * stops silently once stopped/disconnected.
 */
def sendKeepalive() {
    if (state.stage != "SUBSCRIBED") return
    try {
        def messId = nextMessId()
        byte[] header = buildHeader1464(93, 0, HOST_CH_ID, messId, 0)
        log.debug "Sending keepalive (cmd_id=93)"
        sendRaw(header)
    } catch (e) {
        log.warn "Keepalive send failed: ${e.message}"
    }
    runIn(25, "sendKeepalive")
}

/**
 * Handles any message received while SUBSCRIBED. The Hub pushes cmd_id=33
 * (motion/AI/visitor, covering all channels) roughly every 2-3 seconds
 * REGARDLESS of whether anything actually changed -- logging the full raw
 * body every time was mostly noise. Now only logs the watched channel's own
 * values, and only when they actually CHANGE from what was last seen --
 * same "log transitions, not steady state" approach used throughout the
 * production app (sendIfChanged()). Everything not related to the watched
 * channel's motion/AI/sleep status drops to debug-only.
 */
private void handlePushedEvent(int cmdId, String bodyText) {
    int ch = (channel != null ? channel : 4) as int

    if (cmdId == 33) {
        def elem = findChannelElement(bodyText, "AlarmEvent", ch)
        def status = elem?.status?.text()
        def aiType = elem?.AItype?.text()
        if (status != state.last33Status || aiType != state.last33AiType) {
            log.info "***** Ch ${ch} motion/AI CHANGED: status='${status}', AItype='${aiType}' *****"
            state.last33Status = status
            state.last33AiType = aiType
        } else {
            log.debug "Ch ${ch} motion/AI push, unchanged (status='${status}', AItype='${aiType}')"
        }
    } else if (cmdId == 145) {
        def elem = findChannelElement(bodyText, "ChannelInfo", ch)
        def sleepState = elem?.state?.text()
        if (sleepState != state.last145State) {
            log.info "***** Ch ${ch} sleep status CHANGED: '${sleepState}' *****"
            state.last145State = sleepState
        } else {
            log.debug "Ch ${ch} sleep status push, unchanged ('${sleepState}')"
        }
    } else {
        log.debug "Pushed event, cmd_id ${cmdId} (not the watched channel's motion/sleep data)"
    }
}

/** Finds a specific channel's element within a repeated-element push body (e.g. <AlarmEvent><channelId>N</channelId>...</AlarmEvent> repeated per channel). Returns null if not found or unparseable. */
private findChannelElement(String xml, String elementName, int ch) {
    if (!xml) return null
    try {
        def root = new XmlSlurper().parseText(xml)
        return root.depthFirst().find { it.name() == elementName && it.channelId?.text() == ch.toString() }
    } catch (e) {
        log.debug "Failed to parse pushed event XML: ${e.message}"
        return null
    }
}

