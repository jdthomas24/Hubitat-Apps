def sendVerify() {
    state.stage = "AWAITING_VERIFY"
    def messId = nextMessId()
    byte[] header = buildHeader1464(806, 0, HOST_CH_ID, messId, 0)
    log.info "Step 5/5: verifying webhook registration (cmd_id=806)"
    sendRaw(header)
}

// ============================================================================
// Step 6: logout + close
// ============================================================================
def sendLogoutAndClose() {
    state.stage = "DONE"
    try {
        String xml = String.format(LOGOUT_XML, username, password)
        byte[] bodyBytes = xml.getBytes("UTF-8")
        byte[] encBody = aesEncrypt(bodyBytes)
        def messId = nextMessId()
        byte[] header = buildHeader1464(2, bodyBytes.length, HOST_CH_ID, messId, 0)
        sendRaw(concatBytes(header, encBody))
    } catch (e) {
        log.debug "Logout send failed (non-fatal): ${e.message}"
    }
    runIn(1, "closeSocket")
}

def closeSocket() {
    try { interfaces.rawSocket.close() } catch (e) { }
    log.info "===== TEST WEBHOOK FLOW: END ====="
}

// ============================================================================
// Incoming data -- Hubitat delivers raw socket bytes as a hex string here.
// Buffers across calls (state.rxBufferHex) since one Baichuan message can
// arrive split across multiple parse() invocations, or multiple messages
// could arrive in one invocation -- same problem reolink_aio's
// bc_data_received()/parse_bc_data() solve in Python, reimplemented here
// against Hubitat's hex-string delivery instead of raw Python bytes.
// ============================================================================
def parse(String message) {
    if (!message) return
    state.rxBufferHex = (state.rxBufferHex ?: "") + message
    processBuffer()
}

private void processBuffer() {
    String hex = state.rxBufferHex ?: ""
    // Need at least the first 20 bytes (40 hex chars) to read a header.
    if (hex.length() < 40) return

    if (hex.substring(0, 8).toLowerCase() != HEADER_MAGIC_HEX) {
        log.warn "Received data with invalid magic header (${hex.substring(0, 8)}), dropping buffer"
        state.rxBufferHex = ""
        return
    }

    int cmdId = leHexToInt(hex.substring(8, 16))
    int bodyLen = leHexToInt(hex.substring(16, 24))
    int chId = Integer.parseInt(hex.substring(24, 26), 16)
    String encTypeMarker = hex.substring(32, 36).toLowerCase()
    String messageClass = hex.substring(36, 40).toLowerCase()

    int headerLenBytes
    int payloadOffset
    if (messageClass == "1466") {
        headerLenBytes = 20
        payloadOffset = bodyLen
    } else if (messageClass == "1464" || messageClass == "0000") {
        headerLenBytes = 24
        if (hex.length() < 48) return  // need the payload_offset field too
        payloadOffset = leHexToInt(hex.substring(40, 48))
        if (payloadOffset == 0) payloadOffset = bodyLen
    } else {
        log.warn "Received unknown message class '${messageClass}', dropping buffer"
        state.rxBufferHex = ""
        return
    }

    int totalHexNeeded = (headerLenBytes + bodyLen) * 2
    if (hex.length() < totalHexNeeded) return  // wait for the rest

    String bodyHex = hex.substring(headerLenBytes * 2, totalHexNeeded)
    state.rxBufferHex = hex.substring(totalHexNeeded)  // leave any extra message(s) for the next pass

    String bodyText = decryptBody(bodyHex, encTypeMarker, chId)
    handleMessage(cmdId, bodyText)

    // handle multiple messages received in one read
    if (state.rxBufferHex?.length() >= 40) {
        processBuffer()
    }
}

private String decryptBody(String bodyHex, String encTypeMarker, int chId) {
    if (!bodyHex) return ""
    byte[] bodyBytes = hexToBytes(bodyHex)

    // Try whichever cipher the marker suggests first.
    String result = null
    try {
        if (encTypeMarker in ["01dd", "12dd"]) {
            result = new String(xorBaichuan(bodyBytes, chId), "UTF-8")
        } else if (encTypeMarker in ["02dd", "03dd"]) {
            result = new String(aesDecrypt(bodyBytes), "UTF-8")
        } else if (encTypeMarker == "00dd") {
            result = new String(bodyBytes, "UTF-8")
        }
    } catch (e) {
        log.debug "Primary decryption attempt (marker ${encTypeMarker}) threw: ${e.message}"
        result = null
    }

    if (result?.trim()?.startsWith("<?xml")) {
        return result
    }

    // Marker was unrecognized, or the indicated cipher didn't yield valid XML --
    // same defensive fallback the reference library itself uses: try the OTHER
    // cipher before giving up. Post-login, AES is the default expectation, so
    // try that first if we haven't already, then Baichuan-XOR.
    if (encTypeMarker != "02dd" && encTypeMarker != "03dd") {
        try {
            def aesTry = new String(aesDecrypt(bodyBytes), "UTF-8")
            if (aesTry?.trim()?.startsWith("<?xml")) {
                log.debug "Marker '${encTypeMarker}' was unrecognized/wrong, but AES fallback decryption succeeded"
                return aesTry
            }
        } catch (e) { /* fall through */ }
    }
    if (encTypeMarker != "01dd" && encTypeMarker != "12dd") {
        try {
            def bcTry = new String(xorBaichuan(bodyBytes, chId), "UTF-8")
            if (bcTry?.trim()?.startsWith("<?xml")) {
                log.debug "Marker '${encTypeMarker}' was unrecognized/wrong, but Baichuan-XOR fallback decryption succeeded"
                return bcTry
            }
        } catch (e) { /* fall through */ }
    }

    log.warn "Unable to decrypt response body with any known cipher (marker was '${encTypeMarker}') -- raw hex: ${bodyHex.take(200)}"
    return ""
}

// ============================================================================
// Response routing -- advances the state machine based on what we were
// waiting for (state.stage) and what just arrived.
// ============================================================================
/** Maps each stage to the ONLY cmd_id that should be allowed to advance it. Anything else arriving while in that stage is a stray unsolicited push (the device sends these on its own -- floodlight status, sleep status, etc.) and must be ignored, not mistaken for the real answer. */
@Field static final Map<String, Integer> STAGE_EXPECTED_CMD_ID = [
    "AWAITING_NONCE": 1,
    "AWAITING_LOGIN": 1,
    "AWAITING_ABILITY": 199,
    "AWAITING_WEBHOOK_REG": 807,
    "AWAITING_VERIFY": 806,
    "AWAITING_SUBSCRIBE": 31
]

private void handleMessage(int cmdId, String bodyText) {
    // SUBSCRIBED is the one stage where ANY cmd_id is valid and expected --
    // that's the whole point, real pushed events arrive under many different
    // cmd_ids (33=motion/AI/visitor, 145=sleep, etc). Route those separately,
    // skipping the strict single-expected-cmd_id gate used everywhere else.
    if (state.stage == "SUBSCRIBED") {
        handlePushedEvent(cmdId, bodyText)
        return
    }

    log.info "Received cmd_id ${cmdId}, stage was ${state.stage} -- body: ${escapeForLog(bodyText?.take(300))}"

    Integer expectedCmdId = STAGE_EXPECTED_CMD_ID[state.stage]
    if (expectedCmdId != null && cmdId != expectedCmdId) {
        log.debug "cmd_id ${cmdId} does not match what stage ${state.stage} is waiting for (expected ${expectedCmdId}) -- unsolicited push, ignoring, still waiting"
        return
    }

    switch (state.stage) {
        case "AWAITING_NONCE":
            def nonce = findXmlValue(bodyText, "nonce")
            if (!nonce) {
                log.warn "===== TEST FLOW: no nonce found in response, cannot continue ====="
                state.stage = null
                return
            }
            state.nonce = nonce
            state.aesKeyHex = bytesToHex(deriveAesKey(nonce, password))
            log.info "Nonce obtained, AES key derived"
            sendLoginRequest()
            break

        case "AWAITING_LOGIN":
            log.info "Login response received -- assuming success (no error thrown means status 200/201/300)"
            if (state.testMode == "subscribe") {
                sendSubscribe()
            } else {
                sendAbilityCheck()
            }
            break

        case "AWAITING_ABILITY":
            // Full, untruncated, HTML-escaped dump -- need to actually SEE the real
            // field names for this hub-relayed channel rather than guess further.
            log.info "FULL ability response (escaped for log display):"
            log.info escapeForLog(bodyText)
            def webhookAbility = findXmlValue(bodyText, "webhook")
            def supported = (webhookAbility != null) && (webhookAbility.trim() != "0") && (webhookAbility.trim() != "")
            log.info "Webhook ability field: '${webhookAbility}' -- ${supported ? 'SUPPORTED' : 'NOT reported as supported (or field not found)'}"
            if (!supported) {
                log.warn "===== TEST WEBHOOK FLOW: this device/firmware does not report webhook support -- stopping here ====="
                sendLogoutAndClose()
                return
            }
            if (!webhookUrl) {
                log.info "No webhook URL configured -- handshake and capability check both succeeded, stopping before registration"
                sendLogoutAndClose()
                return
            }
            sendWebhookRegister()
            break

        case "AWAITING_WEBHOOK_REG":
            log.info "Webhook registration response received, verifying..."
            sendVerify()
            break

        case "AWAITING_VERIFY":
            def enable = findXmlValue(bodyText, "enable")
            def url = findXmlValue(bodyText, "url")
            log.info "Verify response -- enable=${enable}, url=${url}"
            if (enable == "1" && url == webhookUrl) {
                log.info "===== TEST WEBHOOK FLOW: SUCCESS -- webhook registered and verified! ====="
            } else {
                log.warn "===== TEST WEBHOOK FLOW: verify response did not match what we registered ====="
            }
            sendLogoutAndClose()
            break

        case "AWAITING_SUBSCRIBE":
            log.info "===== EVENT SUBSCRIPTION: ACTIVE -- now listening indefinitely. Walk in front of the " +
                "doorbell/camera to test. Run stopEventSubscription when done. ====="
            state.stage = "SUBSCRIBED"
            unschedule("flowTimeoutCheck")
            runIn(25, "sendKeepalive")
            break

        default:
            log.debug "Received message while not expecting one (stage=${state.stage}), ignoring"
    }
}

