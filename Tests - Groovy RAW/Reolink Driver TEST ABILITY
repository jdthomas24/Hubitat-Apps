/**
 * Reolink Ability Test Tool (STANDALONE -- NOT part of the Reolink Integration app)
 *
 * ============================================================================
 * WHAT THIS IS FOR
 * ============================================================================
 * We're building capability auto-detection (PTZ, calibration, spotlight,
 * AI categories, etc.) into the real Reolink Integration app, but Reolink's
 * GetAbility API response isn't documented consistently across camera
 * models. This tool captures the RAW response from YOUR camera so we can
 * confirm the real field names/values across as many different models as
 * possible before writing the real parsing logic.
 *
 * This tool is completely separate from the Reolink Integration app -- it
 * has its own login/token, doesn't touch your existing sources or child
 * devices, and installing/using/deleting it cannot affect anything in the
 * real integration. Delete this device (and the driver) once you're done
 * testing -- it's not meant to be a permanent installation.
 *
 * The log output has NO personal info in it -- no username, password, or
 * token is ever logged, only the camera's own ability/feature data. Safe to
 * paste directly into a forum post or GitHub issue.
 *
 * ============================================================================
 * HOW TO USE IT (5 minutes)
 * ============================================================================
 *  1. Drivers Code > New Driver > paste this entire file in > Save.
 *  2. Devices > Add Device > Virtual > pick "Reolink Ability Test Tool" as
 *     the type > give it any name (tip: name it after the camera you're
 *     testing, e.g. "Test - Argus Pro") > Save.
 *  3. On the new device's page, open Preferences and fill in:
 *       - Camera IP address (the CAMERA's IP, NOT your Hubitat hub's IP --
 *         double check this, it's the most common mistake)
 *       - HTTPS port (443 unless you've changed it)
 *       - Username / Password (this camera's admin login)
 *       - Channel (leave at the default of 0 unless you know this camera
 *         is a channel behind an NVR/Home Hub, in which case use its
 *         channel number)
 *     Hit Save Preferences.
 *  4. Go to the Commands tab and click "Test All". That's the only button
 *     you need -- it logs in, pulls the camera's model/name, and pulls its
 *     full ability data, all in one click, all tagged so it's easy to read.
 *  5. Go to the Logs tab (or Logs in the left nav, filtered to this device)
 *     and copy EVERYTHING between the "TEST ALL: START" and "TEST ALL: END"
 *     lines -- paste that whole block back. Please also mention the camera
 *     model in your reply even though it's usually captured automatically,
 *     just in case that call fails on your particular model.
 *
 * If something fails partway through (e.g. login works but GetAbility
 * doesn't), that failure itself is useful information -- paste whatever
 * printed before the failure plus the warning/error line.
 *
 * testLogin / testGetDevInfo / testGetAbility are also available
 * individually on the Commands tab if you ever need to re-run just one
 * step, but "Test All" is the one to use normally.
 * ============================================================================
 */
metadata {
    definition(name: "Reolink Ability Test Tool", namespace: "jdthomas24", author: "Jason") {
        capability "Actuator"
        command "testAll", [[name: "The only button you need -- logs in, pulls device info, pulls ability data, all in one go"]]
        command "testLogin", [[name: "Advanced: just confirms login works"]]
        command "testGetDevInfo", [[name: "Advanced: just pulls camera model/name"]]
        command "testGetAbility", [[name: "Advanced: just pulls ability data (needs a valid login first)"]]
    }
    preferences {
        input name: "host", type: "text", title: "Camera IP address",
            description: "The CAMERA's own IP -- NOT your Hubitat hub's IP. Double check this."
        input name: "port", type: "number", title: "HTTPS port", defaultValue: 443
        input name: "username", type: "text", title: "Username"
        input name: "password", type: "password", title: "Password"
        input name: "channel", type: "number", title: "Channel", defaultValue: 0,
            description: "Leave at 0 for a standalone camera. Only change this if testing a specific " +
                "channel behind an NVR/Home Hub."
    }
}

def installed() {}
def updated() {}

/** The one button testers need -- runs login, device info, and ability all in sequence with clear start/end markers. */
def testAll() {
    def ch = (channel != null ? channel : 0) as Integer
    log.info "===== TEST ALL: START (channel ${ch}) ====="

    def token = doLogin()
    if (!token) {
        log.warn "===== TEST ALL: STOPPED -- login failed, see warning above. Check IP/port/username/password " +
            "and that HTTP/HTTPS/ONVIF are enabled in the camera's own Network > Advanced settings. ====="
        return
    }
    log.info "Login: OK"

    def devLabel = doGetDevInfo(token)

    doGetAbility(token, ch, devLabel)

    log.info "===== TEST ALL: END (${devLabel ?: 'model unknown -- please mention it in your reply'}) ====="
}

def testLogin() {
    def token = doLogin()
    if (token) {
        log.info "Reolink Ability Test Tool: login succeeded, token acquired (not logged -- sensitive)"
    } else {
        log.warn "Reolink Ability Test Tool: login failed -- check IP/port/username/password and check that " +
            "HTTP/HTTPS/ONVIF are enabled in the camera's own Network > Advanced settings"
    }
}

def testGetDevInfo() {
    def token = validToken()
    if (!token) return
    doGetDevInfo(token)
}

def testGetAbility() {
    def token = validToken()
    if (!token) return
    def ch = (channel != null ? channel : 0) as Integer
    doGetAbility(token, ch, null)
}

/** Returns a cached token if still valid, otherwise logs in fresh. Used by the individual advanced commands. */
private String validToken() {
    def token = state.token
    if (!token || (state.tokenExpires ?: 0) < now()) {
        token = doLogin()
        if (!token) {
            log.warn "Reolink Ability Test Tool: no valid token, run Test Login (or Test All) first"
            return null
        }
    }
    return token
}

private String doLogin() {
    def body = [[cmd: "Login", param: [User: [userName: username, password: password]]]]
    def uri = "https://${host}:${port}/cgi-bin/api.cgi?cmd=Login"
    def token = null
    try {
        httpPost([uri: uri, ignoreSSLIssues: true, requestContentType: "application/json",
                  body: groovy.json.JsonOutput.toJson(body), timeout: 10]) { resp ->
            def raw = resp?.data?.toString()
            def parsed = raw ? new groovy.json.JsonSlurper().parseText(raw) : null
            def first = parsed?.getAt(0)?.value
            token = first?.Token?.name
            def leaseSec = (first?.Token?.leaseTime ?: 3600) as Integer
            if (token) {
                state.token = token
                state.tokenExpires = now() + (leaseSec * 1000L) - 30000L
            } else {
                log.warn "Reolink Ability Test Tool: login response had no token -- raw: ${raw?.take(300)}"
            }
        }
    } catch (e) {
        log.warn "Reolink Ability Test Tool: login request failed -- ${e.message}"
    }
    return token
}

/**
 * Pulls the camera's own model/name via GetDevInfo and logs it, so every log
 * dump is self-identifying without a tester needing to remember to mention
 * it separately. Returns a short "Name (Model)" label for use in later log
 * lines, or null if the call failed.
 */
private String doGetDevInfo(String token) {
    def uri = "https://${host}:${port}/cgi-bin/api.cgi?cmd=GetDevInfo&token=${token}"
    def body = [[cmd: "GetDevInfo", action: 0, param: [:]]]
    String label = null
    try {
        httpPost([uri: uri, ignoreSSLIssues: true, requestContentType: "application/json",
                  body: groovy.json.JsonOutput.toJson(body), timeout: 10]) { resp ->
            def raw = resp?.data?.toString()
            log.info "GetDevInfo (raw) -- ${raw}"
            try {
                def parsed = new groovy.json.JsonSlurper().parseText(raw)
                def devInfo = parsed?.getAt(0)?.value?.DevInfo
                def name = devInfo?.name ?: "unknown name"
                def model = devInfo?.model ?: "unknown model"
                label = "${name} (${model})"
                log.info "Device identified as: ${label}"
            } catch (e) {
                log.info "GetDevInfo response wasn't parseable JSON -- ${e.message}"
            }
        }
    } catch (e) {
        log.warn "Reolink Ability Test Tool: GetDevInfo request failed -- ${e.message}"
    }
    return label
}

/**
 * Pulls the full GetAbility response and logs it raw, plus a best-effort
 * guess at the per-channel slice (Ability.abilityChn[channel]) confirmed
 * against several camera models so far. devLabel (from doGetDevInfo, if
 * available) is stamped into the log lines so the dump is self-identifying.
 */
private void doGetAbility(String token, Integer chNum, String devLabel) {
    def tag = devLabel ? " [${devLabel}]" : ""
    def body = [[cmd: "GetAbility", action: 0, param: [User: [userName: username]]]]
    def uri = "https://${host}:${port}/cgi-bin/api.cgi?cmd=GetAbility&token=${token}"
    try {
        httpPost([uri: uri, ignoreSSLIssues: true, requestContentType: "application/json",
                  body: groovy.json.JsonOutput.toJson(body), timeout: 10]) { resp ->
            def raw = resp?.data?.toString()
            log.info "GetAbility RAW RESPONSE${tag} (channel ${chNum}, full, unparsed) --"
            log.info raw
            try {
                def parsed = new groovy.json.JsonSlurper().parseText(raw)
                def abilityChn = parsed?.getAt(0)?.value?.Ability?.abilityChn
                if (abilityChn instanceof List && chNum < abilityChn.size()) {
                    log.info "GetAbility per-channel slice${tag} (Ability.abilityChn[${chNum}]) --"
                    log.info groovy.json.JsonOutput.toJson(abilityChn[chNum])
                } else {
                    log.info "GetAbility response didn't match the Ability.abilityChn[] shape -- see the raw " +
                        "response above for the actual structure"
                }
            } catch (e) {
                log.info "GetAbility response wasn't parseable JSON, or didn't match the expected shape -- " +
                    "see the raw response above (${e.message})"
            }
        }
    } catch (e) {
        log.warn "Reolink Ability Test Tool: GetAbility request failed -- ${e.message}"
    }
}
